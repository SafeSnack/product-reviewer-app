# Public Chrome Web Store URL (optional). If set, /install redirects there.
# NEXT_PUBLIC_CHROME_WEBSTORE_URL=

# Google Form waitlist (optional). Create a form with one Short answer question (email).
# 1. Form → Send → link icon → copy form URL; replace /viewform with /formResponse OR use the
#    published formResponse URL from form HTML (action on <form>).
# 2. Field name: open the form in a browser, View Page Source, search for "entry." — use the full
#    token (e.g. entry.1234567890).
NEXT_PUBLIC_EMAIL_FORM_ACTION_URL=
NEXT_PUBLIC_EMAIL_FORM_ENTRY_KEY=

# Optional public GitHub repo for landing footer link.
# NEXT_PUBLIC_GITHUB_URL=

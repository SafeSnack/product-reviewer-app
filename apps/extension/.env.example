# Sentry (optional). Get DSN from https://sentry.io — Browser / JavaScript project.
# Never commit real DSN in git; set in local `.env` or CI secrets.
VITE_SENTRY_DSN=
# Optional override for Sentry "environment" tag (defaults to Vite MODE).
VITE_SENTRY_ENV=
# Set to 1 to throw once in the background worker after Sentry init (verify delivery; dev only).
VITE_SENTRY_THROW_ON_START=

# PostHog (optional, v2+).
# VITE_POSTHOG_CAPTURE_URL=
